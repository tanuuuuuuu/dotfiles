#!/bin/bash
# herdr-pane-shift <left|right|up|down> [pane_id]
#
# ペインを指定方向へ「押し出す」。判定は3段階:
#   1. スタックの相棒がいれば、列/行として抜け出す
#      - h/l: 同じ列に相棒がいる → 列として左/右に抜ける
#        例) a | (c/b) で c に left → a | c | b
#      - j/k: 同じ行に相棒がいる → 行として下/上に抜ける。
#        読み順（左→右）を保つため j は左隣・k は右隣とペアになる
#        例) a b c で b に down → (a/b) | c
#   2. いなければ、その方向の隣と位置を交換（swap）
#      例) 3列の真ん中で left → 左の列と入れ替え / スタック内で down → 上下入れ替え
#   3. それもいなければ、反対軸の隣（フォーカス履歴依存）に割り込む
#      例) 横一列 a b の a に down → b / a
#
# 挿入は常に「自分が相手の右/下に入る → up/left のときは swap で前に出る」。
# 同一タブ内の pane move は same_tab として無視されるため、
# 一旦 --new-tab に退避してから戻す2段移動で実現する（空タブは自動で閉じる）。
set -euo pipefail

# デバッグログ（キーバインド経由の失敗は画面に出ないため）
LOG=/tmp/herdr-pane-shift.log
exec 2>>"$LOG"
log() { echo "[$(date +%H:%M:%S)] $*" >> "$LOG"; }
trap 'log "EXIT code=$?"' EXIT

dir="$1"
case "$dir" in
    left|right|up|down) ;;
    *) echo "usage: herdr-pane-shift <left|right|up|down> [pane_id]" >&2; exit 2 ;;
esac
log "invoked dir=$dir arg2=${2:-}"

jneighbor() { jq -r '.result.neighbor.neighbor_pane_id // ""'; }

cur="${2:-$(herdr pane current --current | jq -r '.result.pane.pane_id')}"

# 1. スタックの相棒（同じ列/行で隣接するペイン）を探す
decision=$(herdr pane layout --pane "$cur" | jq -r --arg cur "$cur" --arg d "$dir" '
    .result.layout as $L
    | ($L.panes[] | select(.pane_id == $cur) | .rect) as $c
    | ($c.x + $c.width) as $cx2 | ($c.y + $c.height) as $cy2
    | [ $L.panes[]
        | select(.pane_id != $cur)
        | {id: .pane_id, x: .rect.x, y: .rect.y,
           x2: (.rect.x + .rect.width), y2: (.rect.y + .rect.height)} ] as $others
    | (if ($d == "left" or $d == "right") then
           # 同じ列の相棒。下側を優先
           [ $others[] | select(.x == $c.x and .x2 == $cx2 and (.y == $cy2 or .y2 == $c.y)) ]
           | (map(select(.y == $cy2)) + .)
       else
           # 同じ行の相棒。読み順を保つため down は左隣・up は右隣を優先
           [ $others[] | select(.y == $c.y and .y2 == $cy2 and (.x == $cx2 or .x2 == $c.x)) ]
           | (if $d == "down" then map(select(.x2 == $c.x)) + .
                              else map(select(.x == $cx2)) + . end)
       end) as $mates
    | "\($mates[0].id // "-") \($L.tab_id)"
')
read -r mate tab <<< "$decision"
log "cur=$cur mate=$mate"

target="$mate"
if [ "$target" = "-" ]; then
    # 2. スタックにいない → その方向の隣と swap
    nb=$(herdr pane neighbor --pane "$cur" --direction "$dir" | jneighbor)
    if [ -n "$nb" ]; then
        log "swap nb=$nb"
        herdr pane swap --source-pane "$cur" --target-pane "$nb" > /dev/null
        exit 0
    fi
    # 3. 反対軸の隣（herdr のフォーカス履歴を考慮した解決）に割り込む
    case "$dir" in
        up|down)    axis1=right axis2=left ;;
        left|right) axis1=down  axis2=up ;;
    esac
    target=$(herdr pane neighbor --pane "$cur" --direction "$axis1" | jneighbor)
    if [ -z "$target" ]; then
        target=$(herdr pane neighbor --pane "$cur" --direction "$axis2" | jneighbor)
    fi
    log "fallback target=$target"
    [ -z "$target" ] && exit 0  # 1ペインのみ
fi

case "$dir" in
    left|right) split=right ;;
    up|down)    split=down ;;
esac

# 自分が target の右/下へ割り込み、up/left なら swap で前に出る
herdr pane move "$cur" --new-tab --no-focus > /dev/null
herdr pane move "$cur" --tab "$tab" --split "$split" --target-pane "$target" --focus > /dev/null
case "$dir" in
    up|left) herdr pane swap --source-pane "$cur" --target-pane "$target" > /dev/null ;;
esac

# --- サイズ正規化 ---
# 割り込みは target のセルを半割するため、target が既に半分サイズだと
# 1/4 幅のスリバーが生まれる。合流した行/列（同一軸の分割チェーン）を、
# 「新入り（自分）は均等シェア、既存メンバーは元の比率を保って残りを分け合う」
# ように layout.set_split_ratio API で再配分する。
SOCK="${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}"
requests=$(herdr pane layout --pane "$cur" | jq -c --arg cur "$cur" --arg tgt "$target" --arg d "$dir" --arg tab "$tab" '
    (if ($d == "left" or $d == "right") then "right" else "down" end) as $axis
    | .result.layout as $L
    | (($L.splits | map(.rect)) + ($L.panes | map(.rect))) as $rects
    # フラットな rect 情報から分割ツリーを再構築する
    | def build($rect; $path):
        ([$L.splits[] | select(.rect == $rect)][0]) as $sp
        | if $sp then
            ( [ $rects[]
                | select(. != $rect)
                | if $sp.direction == "right"
                  then select(.x == $rect.x and .y == $rect.y and .height == $rect.height and .width < $rect.width)
                  else select(.x == $rect.x and .y == $rect.y and .width == $rect.width and .height < $rect.height)
                  end ]
              | (if $sp.direction == "right" then max_by(.width) else max_by(.height) end) ) as $fr
            | (if $sp.direction == "right"
               then {x: ($rect.x + $fr.width), y: $rect.y, width: ($rect.width - $fr.width), height: $rect.height}
               else {x: $rect.x, y: ($rect.y + $fr.height), width: $rect.width, height: ($rect.height - $fr.height)} end) as $sr
            | {type: "split", dir: $sp.direction, rect: $rect, path: $path,
               first: build($fr; $path + [false]), second: build($sr; $path + [true])}
          else
            {type: "pane", id: ($L.panes[] | select(.rect == $rect) | .pane_id), rect: $rect, path: $path}
          end;
      def hasid($n; $id): if $n.type == "pane" then $n.id == $id
                          else hasid($n.first; $id) or hasid($n.second; $id) end;
      # ルートから cur までの分割ノード列
      def walk($n): if $n.type == "pane" then []
                    elif hasid($n.first; $cur) then [$n] + walk($n.first)
                    else [$n] + walk($n.second) end;
      build($L.area; []) as $root
    | walk($root) as $nodes
    | ($nodes | length) as $k
    | if $k == 0 then empty else
      # cur の親から同一軸で連続する最上位ノード = チェーンの根
      ( [range($k) | select(all($nodes[.:][]; .dir == $axis))] | min ) as $top
    | if $top == null then empty else
      $nodes[$top] as $chain
      # チェーンを同一軸で平坦化した「行/列のメンバー」
    | def members($n): if $n.type == "split" and $n.dir == $axis
                       then members($n.first) + members($n.second) else [$n] end;
      def ext($n): if $axis == "right" then $n.rect.width else $n.rect.height end;
      members($chain) as $ms
    | ($ms | length) as $N
    | ($ms | map(ext(.)) | add) as $E
    | if $N < 2 then empty else
      # 目標サイズ: cur は E/N、既存メンバーは挿入前の比率で残りを按分
      def newsize($m):
        if $m.type == "pane" and $m.id == $cur then ($E / $N)
        else ( (if hasid($m; $tgt) then (ext($m) + ($ms[] | select(.type == "pane" and .id == $cur) | ext(.))) else ext($m) end) as $pre
             | ($E - $E / $N) * $pre / $E )
        end;
      def subsum($n): if $n.type == "split" and $n.dir == $axis
                      then subsum($n.first) + subsum($n.second) else newsize($n) end;
      def ratios($n): if $n.type == "split" and $n.dir == $axis
                      then [{path: $n.path, ratio: (subsum($n.first) / subsum($n))}]
                           + ratios($n.first) + ratios($n.second)
                      else [] end;
      ratios($chain)[]
    | {id: "norm", method: "layout.set_split_ratio",
       params: {tab_id: $tab, path: .path, ratio: .ratio}}
    end end end
' 2>> "$LOG") || requests=""
# サーバは1接続につき1リクエストしか処理しないため、接続を分けて送る
if [ -n "$requests" ]; then
    log "normalize: $requests"
    while IFS= read -r req; do
        printf '%s\n' "$req" | nc -U "$SOCK" -w 1 > /dev/null 2>&1 &
    done <<< "$requests"
    wait
fi
